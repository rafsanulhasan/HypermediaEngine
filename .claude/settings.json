{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet sln:*)",
      "Bash(dotnet --version)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet stryker:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet add package:*)",
      "Bash(dotnet add reference:*)",
      "Bash(dotnet remove package:*)",
      "Bash(dotnet remove reference:*)",
      "Bash(dotnet list package:*)",
      "Bash(dotnet list reference:*)",
      "Bash(git --version)",
      "Bash(git status)",
      "Bash(git add:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -ExecutionPolicy Bypass -File .claude/hooks/enforce-tests.ps1"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "sonarqube@claude-plugins-official": true
  }
}
